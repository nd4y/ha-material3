{
  "name": "ha-material3",
  "version": "0.19.5",
  "description": "Configurable Material 3 Expressive panel and cards for Home Assistant",
  "type": "module",
  "license": "Apache-2.0",
  "scripts": {
    "build": "node scripts/build.mjs",
    "test:frontend": "node --test tests/*.test.mjs",
    "test:controller": "node scripts/test-controller.mjs",
    "test": "npm run test:frontend && npm run test:controller",
    "prebuild": "npm run test",
    "check": "npm run build && node scripts/audit-release.mjs",
    "dev": "node scripts/dev-server.mjs"
  },
  "dependencies": {
    "lit": "3.3.3",
    "@material/material-color-utilities": "0.4.0"
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "@fontsource-variable/roboto": "5.3.0",
    "@material/web": "2.5.0",
    "axe-core": "4.14.0"
  }
}
