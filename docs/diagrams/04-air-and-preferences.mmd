flowchart TD
 A["Базовая потребность по профилю и валидным CO₂ / PM2.5"] --> V{"Пожелания и числовые параметры корректны?"}
 V -->|Нет| BAD["Приостановить управление; не создавать фиктивный ноль"]
 V -->|Да| P["Коррекция относительно базы: округление signed-bias; это не процент мотора"]
 P --> FLOOR["Запрос = max базы с поправкой, потребности датчика, положительного минимума"]
 FLOOR --> CAP["Дополнительная тишина уменьшает мягкие пределы; положительный предел не ниже 1"]
 CAP --> OFF{"Явный Off?"}
 OFF -->|Да| Z["Базовый запрос 0"]
 OFF -->|Нет| MAX{"Общий Maximum?"}
 MAX -->|Да| HW["Запрос аппаратного максимума"]
 MAX -->|Нет| BASE["Запрос после пожеланий"]
 Z --> BOOST
 HW --> LIM
 BASE --> BOOST{"Усиление активно: deadline больше now, мастер включён, не Maximum?"}
 BOOST -->|Да| PLUS["Прибавка в пределах собственного потолка ниже hardware max; не снижать уже высокий запрос"]
 BOOST -->|Нет| LIM
 PLUS --> LIM["Итог = min запроса, hardware, hard cap, noise cap"]
 LIM --> PWR{"Итог положительный?"}
 PWR -->|Да| SPEED{"Скорость разрешена, питание уже on или включение разрешено?"}
 SPEED -->|Нет| STOP["Блокировка параметра или питания; журнал"]
 SPEED -->|Да| SEND["Проверить здоровье и допуск непосредственно перед командой"]
 PWR -->|Нет| ZERO{"Автоматическое питание разрешено?"}
 ZERO -->|Да| SEND
 ZERO -->|Нет| STOP
