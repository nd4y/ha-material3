flowchart TD
 A["Предложение физической команды"] --> VALID{"Типы, цель и payload корректны?"}
 VALID -->|Нет| DENY["Блокировать и записать причину"]
 VALID -->|Да| F{"Аварийное выключение?"}
 F -->|Да| FS{"Это stop, устройство доступно, явная ошибка подтверждена и latch установлен?"}
 FS -->|Да| SAFE["Разрешить только адресное safety shutdown"]
 FS -->|Нет| DENY
 F -->|Нет| AV{"Устройство доступно?"}
 AV -->|Нет| DENY
 AV -->|Да| STOP{"Ручной stop?"}
 STOP -->|Да| SEND
 STOP -->|Нет| EL{"Обычный допуск по здоровью есть?"}
 EL -->|Нет| DENY
 EL -->|Да| AUTO{"Команда автоматическая?"}
 AUTO -->|Нет| SEND
 AUTO -->|Да| MASTER{"Мастер включён; транзакция не идёт; ревизия не устарела?"}
 MASTER -->|Нет| DENY
 MASTER -->|Да| POWER{"Питание разрешено ИЛИ вручную закреплено on и уже on без запроса stop?"}
 POWER -->|Нет| DENY
 POWER -->|Да| PARAM{"Этот параметр разрешён автоматике?"}
 PARAM -->|Нет| DENY
 PARAM -->|Да| FAN["Для AC fan: свежий quiet cap; выбрать поддерживаемую скорость; Auto только при полном бюджете"]
 FAN --> SUP{"Допустимый режим найден и последняя ревизия актуальна?"}
 SUP -->|Нет| DENY
 SUP -->|Да| SAME{"Настройка уже совпадает?"}
 SAME -->|Да| NOOP["Без повторной команды"]
 SAME -->|Нет| SEND["Отправить; отдельно записать факт отправки"]
 SAFE --> SEND
 SEND --> CONF{"HA подтвердил ожидаемое состояние до тайм-аута?"}
 CONF -->|Да| YES["Подтверждено HA; это не независимое измерение физического результата"]
 CONF -->|Нет| NO["Не подтверждено; причина в журнале / уведомлении"]
