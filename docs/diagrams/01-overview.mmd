flowchart TD
  E["Настройка, входящий отчёт или тик 60 с"] --> Q["Объединение событий: 0,25 с; предел 2 с"]
  Q --> S["Один снимок: факты, намерения, возможности, память"]
  S --> P["Чистый расчёт потребностей всех устройств"]
  P --> J["Совместный план с ручными ограничениями"]
  J --> G{"Есть допустимый следующий шаг?"}
  G -- "нет" --> W["Сохранить причину и ждать события"]
  G -- "да" --> V["Сохранить операцию; заново проверить актуальность"]
  V --> A{"Шаг ещё допустим?"}
  A -- "нет" --> N["Следующий расчёт по актуальному снимку"]
  A -- "да" --> X["Передать команду через адаптер"]
  X --> R["Входящий отчёт или неопределённый результат"]
  R --> N
  W --> N
