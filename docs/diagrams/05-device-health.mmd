flowchart TD
 A["Нормализовать доступность, источник ошибки, питание, latch и attempted"] --> ERR{"Явная известная ошибка устройства?"}
 ERR -->|Да| VALID{"Сохранённое состояние latch / attempted корректно?"}
 VALID -->|Нет| INVALID["Ошибка видна; обычные команды и неподтверждённый safety override запрещены"]
 INVALID --> DEDUP
 VALID -->|Да| LATCH["Сохранить карантин"]
 LATCH --> CAN{"Доступно, ещё не выключено, попытка ещё не записана?"}
 CAN -->|Да| SAVE["Сначала сохранить attempted=true"]
 SAVE --> OFF["Одна адресная попытка выключения; допустим safety override ручного питания"]
 OFF --> CONF{"HA подтверждает off?"}
 CONF -->|Да| OK["Выключение подтверждено HA"]
 CONF -->|Нет| NCONF["Выключение не подтверждено; не повторять бесконечно"]
 CAN -->|Нет| MSG["Уведомление с фактическим статусом"]
 OK --> MSG
 NCONF --> MSG
 ERR -->|Нет| AV{"Устройство доступно?"}
 AV -->|Нет| NA["Недоступно: обычных команд нет; пожелания сохранены"]
 AV -->|Да| KNOWN{"Источник ошибки чистый и сохранённое состояние корректно?"}
 KNOWN -->|Нет| UNK["Здоровье неизвестно: исключить и уведомить"]
 KNOWN -->|Да| L{"Остался latch после прошлой ошибки?"}
 L -->|Нет| HEALTHY["Исправно: обычный допуск"]
 L -->|Да| ACK{"Источник ошибки чистый и пользователь подтвердил восстановление?"}
 ACK -->|Нет| Q["Карантин остаётся; самовключение запрещено"]
 ACK -->|Да| CLEAR["Снять latch и attempted, убрать уведомление; не включать устройство автоматически этим действием"]
 MSG --> DEDUP["Уведомлять при изменении состояния; перезапуск не сбрасывает latch / attempted"]
