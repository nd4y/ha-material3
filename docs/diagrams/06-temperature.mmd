flowchart TD
 A["Измеренная и желаемая температура + состояния устройств"] --> AV{"Кондиционер доступен?"}
 AV -->|Нет| UN["Недоступен: не управлять"]
 AV -->|Да| VALID{"Мастер включён, температура достоверна, ошибки нет?"}
 VALID -->|Нет| REL["Остановить принадлежащий автоматике цикл либо освободить управление"]
 VALID -->|Да| CON{"Закреплён нагрев притока и комната выше цели?"}
 CON -->|Да| PAUSE["Приостановить охлаждение; не бороться с ручной настройкой"]
 CON -->|Нет| MAN{"Ручной режим HVAC вне разрешённого набора?"}
 MAN -->|Да| RELEASE["Освободить управление"]
 MAN -->|Нет| OWN{"Цикл наш, но режим уже не cool / heat?"}
 OWN -->|Да| REC["Reconcile: защитная пауза после остановки"]
 OWN -->|Нет| ACTIVE{"Уже cool или heat?"}
 ACTIVE -->|Да| BOUND{"Защитный порог ±0.5 °C пересечён?"}
 BOUND -->|Да| STOP["Stop если цикл наш; иначе adopt"]
 BOUND -->|Нет| REACHED{"Наш цикл, прошло 300 с, цель достигнута с допуском 0.1 °C?"}
 REACHED -->|Да| STOP
 REACHED -->|Нет| MAINT["Maintain / adopt; удерживать уставку"]
 ACTIVE -->|Нет| HOT{"Комната выше цели минимум на 0.7 °C?"}
 HOT -->|Да| COOL["Cool после 300-секундной защитной паузы"]
 HOT -->|Нет| COLD{"Ниже цели на 0.7 °C, бризер на пределе?"}
 COLD -->|Да| HEAT["Heat после защитной паузы и выдержки недостаточного нагрева"]
 COLD -->|Нет| IDLE["В пределах допуска / бризер справляется"]
 MAINT --> ADJ{"Новая цель либо прошли 600 с и нужна коррекция?"}
 ADJ -->|Нет| HOLD["Не отправлять лишнюю уставку"]
 ADJ -->|Да| STEP["Новая цель: пересчёт; обычная коррекция максимум 1 °C за шаг"]
 B["Параллельно: бризер"] --> BG{"Температура / питание разрешены и источник достоверен?"}
 BG -->|Нет| BH["Сохранить ручную настройку / приостановить"]
 BG -->|Да| TURBO{"Штатный Turbo устройства?"}
 TURBO -->|Да| FIVE["Приток 5 °C в пределах внешних защит"]
 TURBO -->|Нет| PI["PI-регулятор с anti-windup и ограничением шага; противоположный нагрев/охлаждение исключить"]
