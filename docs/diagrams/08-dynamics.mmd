flowchart TD
 A["Критичность загрязнения"] --> V{"Типы, сроки и состояния on/off/unknown корректны?"}
 V -->|Нет| BAD["Ни одного управляющего эффекта"]
 V -->|Да| ALL["Рассчитать шесть независимых условий; эффекты применяет адаптер"]
 ALL --> P["above и pending не on: начать pending"]
 ALL --> CP["не above и pending не off: отменить pending"]
 ALL --> ACT["above, pending on, выдержка достигнута, active не on: активировать"]
 ALL --> SC["valid, clear и clear_pending не on: начать восстановление"]
 ALL --> CC["не clear и clear_pending не off: отменить восстановление"]
 ALL --> REL["active не off и источник невалиден либо clear выдержан: снять критичность"]
 I["PI притока"] --> IV{"Данные, tuning и текущая уставка корректны?"}
 IV -->|Нет| NONE["Нет команды; не подставлять ноль"]
 IV -->|Да| DT["Reset обнуляет интеграл; force даёт dt=0, иначе dt ограничен"]
 DT --> DB{"Ошибка вне deadband?"}
 DB -->|Да| INTEG["Кандидат интеграла в допустимых границах"]
 DB -->|Нет| OLD["Интеграл не накапливать"]
 INTEG --> SAT{"Насыщение и ошибка толкает дальше за предел?"}
 OLD --> SAT
 SAT -->|Да| FREEZE["Сохранить старый интеграл: anti-windup"]
 SAT -->|Нет| USE["Принять кандидат"]
 FREEZE --> OUT
 USE --> OUT["Ограничить requested диапазоном притока и округлить"]
 OUT --> FORCE{"Force?"}
 FORCE -->|Да| DIRECT["Взять requested"]
 FORCE -->|Нет| RATE["Ограничить шаг относительно текущей уставки"]
